# ─── Deployment & Server ──────────────────────────────────────────────────────
# PORT: Port aplikasi akan berjalan (default: 10313)
PORT=10313

# NEXT_BASE_PATH: Kosongkan untuk subdomain (admin.domain.com)
# Isi "/admin" untuk single domain (domain.com/admin)
NEXT_BASE_PATH=

# ─── Backend API ──────────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL: URL lengkap ke backend API
NEXT_PUBLIC_API_URL=http://localhost:10311

# ─── Frontend URL ─────────────────────────────────────────────────────────────
# NEXT_PUBLIC_FRONTEND_URL: URL publik ke frontend utama (untuk integrasi logo/favicon SSOT)
NEXT_PUBLIC_FRONTEND_URL=http://localhost:10312

# ─── Captcha (Opsional: 'google' | 'turnstile' — kosong = nonaktif) ─────────────
# NEXT_PUBLIC_CAPTCHA_PROVIDER: Provider captcha ('google' atau 'turnstile')
NEXT_PUBLIC_CAPTCHA_PROVIDER=
# NEXT_PUBLIC_CAPTCHA_SITE_KEY: Site Key dari Google reCAPTCHA atau Cloudflare Turnstile
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY: Legacy fallback untuk Google reCAPTCHA (opsional)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
