# ─── Deployment & Server ──────────────────────────────────────────────────────
# PORT: Port aplikasi akan berjalan (default: 10314)
PORT=10314

# NEXT_BASE_PATH: Kosongkan untuk subdomain/root (app.domain.com)
# Isi prefix jika diletakkan di sub-path (misal: /app)
NEXT_BASE_PATH=

# ─── App URLs ─────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_APP_URL: URL publik ke app terautentikasi ini
NEXT_PUBLIC_APP_URL=http://localhost:10314

# NEXT_PUBLIC_FRONTEND_URL: URL publik ke portal web publik
NEXT_PUBLIC_FRONTEND_URL=http://localhost:10312

# ─── Backend API ──────────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL: URL lengkap ke backend API
NEXT_PUBLIC_API_URL=http://localhost:10311

# ─── Google OAuth (One Tap) ───────────────────────────────────────────────────
# NEXT_PUBLIC_GOOGLE_CLIENT_ID: Client ID dari Google Cloud Console (Kosongkan jika tidak pakai login Google)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=dummy-google-client-id.apps.googleusercontent.com

# ─── Captcha (Opsional: 'google' | 'turnstile' — kosong = nonaktif) ─────────────
# NEXT_PUBLIC_CAPTCHA_PROVIDER: Provider captcha ('google' atau 'turnstile')
NEXT_PUBLIC_CAPTCHA_PROVIDER=

# NEXT_PUBLIC_CAPTCHA_SITE_KEY: Site Key dari Google reCAPTCHA atau Cloudflare Turnstile
NEXT_PUBLIC_CAPTCHA_SITE_KEY=

# NEXT_PUBLIC_RECAPTCHA_SITE_KEY: Legacy fallback untuk Google reCAPTCHA (opsional)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# ─── Web Push Notifications (VAPID) ───────────────────────────────────────────
# NEXT_PUBLIC_VAPID_PUBLIC_KEY: Public key VAPID untuk Web Push Notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

